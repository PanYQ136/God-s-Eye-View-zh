/**
 * 小程序地名检索代理 —— `GET /api/mini/geocode?q=上海&limit=6`
 *
 * 为什么单独做：原有 `/api/geocode`（Nominatim + 1 req/s 全局限流 + 队列上限 4）
 * 在本机实测长期 503，小程序搜索就永远「没结果」。这个端点：
 *  - 直接 fetch Nominatim（带合规 UA/Referer），失败再回退 Photon（komoot）；
 *  - 只做进程内 10 分钟缓存，不做队列，失败快速返回，让前端能给出真实提示；
 *  - 输出统一结构 [{name, lat, lon, kind, source}]，小程序直接渲染。
 */

const CACHE_TTL_MS = 10 * 60 * 1000;
const CACHE_MAX = 120;
const cache = new Map();

const UA = 'gods-eye-view/0.1 (+https://github.com/bilawalsidhu/gods-eye-view)';

function normNominatim(arr) {
  return (Array.isArray(arr) ? arr : []).map((h) => ({
    name: h.display_name || h.name || '',
    lat: Number(h.lat),
    lon: Number(h.lon),
    kind: h.type || h.category || 'place',
    source: 'nominatim',
  })).filter((x) => Number.isFinite(x.lat) && Number.isFinite(x.lon) && x.name);
}

function normPhoton(d) {
  const feats = (d && Array.isArray(d.features)) ? d.features : [];
  return feats.map((f) => {
    const c = (f.geometry && f.geometry.coordinates) || [];
    const p = f.properties || {};
    const name = [p.name, p.city, p.state, p.country].filter(Boolean).join(', ');
    return {
      name: name || p.osm_value || '',
      lat: Number(c[1]),
      lon: Number(c[0]),
      kind: p.osm_value || p.type || 'place',
      source: 'photon',
    };
  }).filter((x) => Number.isFinite(x.lat) && Number.isFinite(x.lon) && x.name);
}

async function fetchJson(url, headers, timeoutMs) {
  const ac = new AbortController();
  const timer = setTimeout(() => ac.abort(), timeoutMs);
  try {
    const r = await fetch(url, { signal: ac.signal, headers });
    if (!r.ok) return { ok: false, status: r.status };
    return { ok: true, data: await r.json() };
  } catch (err) {
    return { ok: false, status: 0, error: String((err && err.message) || err) };
  } finally {
    clearTimeout(timer);
  }
}

export function miniGeocodeProxy() {
  const handler = async (req, res) => {
    const url = new URL(req.url, 'http://localhost');
    const q = String(url.searchParams.get('q') || '').trim().slice(0, 120);
    const limit = Math.max(1, Math.min(10, Number(url.searchParams.get('limit')) || 6));
    if (!q) {
      res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
      res.end(JSON.stringify({ error: 'missing_q' }));
      return;
    }

    const key = q.toLowerCase() + '|' + limit;
    const hit = cache.get(key);
    if (hit && Date.now() - hit.at < CACHE_TTL_MS) {
      res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'max-age=600' });
      res.end(JSON.stringify({ query: q, results: hit.rows, cached: true }));
      return;
    }

    let rows = [];
    let source = '';

    const nom = await fetchJson(
      `https://nominatim.openstreetmap.org/search?format=jsonv2&limit=${limit}&accept-language=zh,en&q=${encodeURIComponent(q)}`,
      { 'User-Agent': UA, Referer: 'https://github.com/bilawalsidhu/gods-eye-view', Accept: 'application/json' },
      12000,
    );
    if (nom.ok) { rows = normNominatim(nom.data); source = 'nominatim'; }

    if (!rows.length) {
      const ph = await fetchJson(
        `https://photon.komoot.io/api/?limit=${limit}&q=${encodeURIComponent(q)}`,
        { 'User-Agent': UA, Accept: 'application/json' },
        12000,
      );
      if (ph.ok) { rows = normPhoton(ph.data); source = 'photon'; }
    }

    if (!rows.length) {
      res.writeHead(502, { 'Content-Type': 'application/json; charset=utf-8' });
      res.end(JSON.stringify({ error: 'no_result', query: q, upstream: { nominatim: nom.status, } }));
      return;
    }

    if (cache.size >= CACHE_MAX) cache.delete(cache.keys().next().value);
    cache.set(key, { at: Date.now(), rows });
    res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'max-age=600' });
    res.end(JSON.stringify({ query: q, source, results: rows.slice(0, limit) }));
  };

  return {
    name: 'mini-geocode',
    configureServer({ middlewares }) {
      middlewares.use('/api/mini/geocode', handler);
    },
    configurePreviewServer({ middlewares }) {
      middlewares.use('/api/mini/geocode', handler);
    },
  };
}
